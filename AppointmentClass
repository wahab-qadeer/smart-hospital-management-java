
package p1;

public class Appointment {
    private int appointmentID;
    private String patient;
    private String doctor;
    private String appointmentDate;
    private String appointmentTime;
    private String status;

    public Appointment() {
    }

    public void scheduleAppointment(int appointmentID, String patient, String doctor, String appointmentDate, String appointmentTime, String status) {
        this.appointmentID = appointmentID;
        this.doctor = doctor;
        this.patient = patient;
        this.appointmentDate = appointmentDate;
        this.appointmentTime = appointmentTime;
        this.status = status;
        System.out.println("Your Appointment is Confirm ! Thank you");
    }

    public void cancelAppointment(int recordID, String doctor, String appointmentDate) {
        if (recordID == this.appointmentID && doctor.equals(this.doctor) && appointmentDate.equals(this.appointmentDate)) {
            this.appointmentID = 0;
            this.doctor = null;
            this.appointmentDate = null;
            System.out.println("Thank you your appointment is cancel ");
        }

    }
}
